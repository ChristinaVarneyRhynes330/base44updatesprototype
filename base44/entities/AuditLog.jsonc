{
  "name": "AuditLog",
  "type": "object",
  "description": "Immutable correction and audit history for a case workspace.",
  "properties": {
    "case_id": {
      "type": "string",
      "description": "CaseWorkspace id"
    },
    "entity_type": {
      "type": "string",
      "description": "EvidenceRecord, TimelineEvent, InvestigativeIssue, ..."
    },
    "entity_id": {
      "type": "string"
    },
    "entity_label": {
      "type": "string",
      "description": "Human readable title at the time of the change"
    },
    "action": {
      "type": "string",
      "enum": [
        "created",
        "updated",
        "corrected",
        "flagged",
        "deleted"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow",
        "red",
        "gray"
      ]
    },
    "detail": {
      "type": "string",
      "description": "What changed, in plain language"
    },
    "previous_value": {
      "type": "string",
      "description": "Preserved original value, never overwritten"
    }
  },
  "required": [
    "case_id",
    "entity_type",
    "entity_id",
    "action",
    "detail"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
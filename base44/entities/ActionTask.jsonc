{
  "name": "ActionTask",
  "type": "object",
  "description": "A follow-up task or obligation tracked by workflow stage.",
  "properties": {
    "case_id": {
      "type": "string",
      "description": "CaseWorkspace id"
    },
    "title": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "Immediate Filing",
        "Hearing Preparation",
        "Record Comparison",
        "Timeline Entry",
        "Reference Archive"
      ],
      "enumColors": [
        "red",
        "yellow",
        "blue",
        "purple",
        "gray"
      ]
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "linked_issue_id": {
      "type": "string",
      "description": "InvestigativeIssue id this task supports"
    }
  },
  "required": [
    "case_id",
    "title",
    "stage",
    "completed"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}